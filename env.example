#--------------------------------------------------------------------
# KasKantor — contoh .env. Salin jadi .env lalu isi.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://domain-kamu.example/'
# Pastikan baseURL diakhiri garis miring.

database.default.hostname = localhost
database.default.database = nama_database
database.default.username = user_database
database.default.password = 'password_database'
database.default.DBDriver = MySQLi
database.default.port = 3306

# Isi dengan string acak panjang (contoh: php -r "echo bin2hex(random_bytes(16));")
encryption.key = hex2bin:GANTI_DENGAN_32_BYTE_HEX
